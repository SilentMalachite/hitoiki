{
  "name": "hitoiki",
  "version": "0.1.1",
  "private": true,
  "description": "Resident app that flashes the screen and blocks input to break hyperfocus",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "electron dist/main.js",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "files": [
      "dist/**/*",
      "renderer/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "identity": "-",
      "hardenedRuntime": false
    }
  },
  "devDependencies": {
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
